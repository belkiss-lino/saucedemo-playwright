{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "description": "Testes E2E do SauceDemo com Playwright + TypeScript (Page Object Model)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "e2e", "qa", "page-object-model"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
